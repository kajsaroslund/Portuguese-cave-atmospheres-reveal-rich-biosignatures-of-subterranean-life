```{r}
varimp_df <- varimp %>%
  as.data.frame() %>%
  tibble::rownames_to_column("VOC")

varimp_colname <- names(varimp_df)[2]

varimp_plot <- varimp_df %>%
  arrange(desc(!!sym(varimp_colname)), VOC) %>%
  slice(1:25) %>%
  rename(Variable_importance = !!sym(varimp_colname))

```


```{r}
supervised_mda=ggplot(
  data = varimp_plot,
  mapping = aes(x = reorder(VOC, Variable_importance), 
                y = Variable_importance, col = Variable_importance)
) +
  geom_segment(aes(xend = VOC, yend = 0), color = "black") + 
  theme_classic() + 
  geom_point(size = 3, fill = "black") +  
  coord_flip() + 
  scale_fill_brewer(palette = "Set2") + 
  ggtitle("VOC importance - VOC") +
  labs(x = expression(VOC),
       y = expression(Variable ~ importance)) + 
  theme(legend.position = "none") +
  theme(panel.background = element_rect(
    colour = "black",
    size = 1,
    fill = NA
  ))

supervised_mda

ggsave("VOC importance.pdf", plot = supervised_mda)
```
