```{r}
install.packages("randomForest")
library(randomForest)
library(tidyverse)
library(readxl)
library(cowplot)
```

# Dataset

```{r echo=FALSE, include=FALSE}
voc = read.csv("dataset.csv")
```

```{r, eval=TRUE}
col_names <- names(voc)
special_col_names <- col_names[grep("[^A-Za-z0-9_]", col_names)]
backticked_col_names <- paste0("`", special_col_names, "`")
names(voc)[names(voc) %in% special_col_names] <-
  backticked_col_names

```

```{r}
e = voc[, 4:ncol(voc)]
prop = e / rowSums(e)
prop_voc = cbind(voc[, 1:3], prop) 
```

# Supervised RF

```{r}

separation =
  randomForest(
    prop_voc[, 4:143],#dataframe
    y = as.factor(prop_voc$Season), #variable
    proximity = TRUE,
    mtry = 15, #Variables per split
    importance = TRUE,
    do.trace = 10, #print trees
    ntree = 1000) #N of trees

```

```{r}
  plot(separation)
```

```{r}
print(separation)
```

```{r}
classification = cbind(prop_voc[5], separation$predicted)
head(classification, 10)
```

# Variable importance

```{r, eval=TRUE, echo=FALSE}
varimp =
  importance(separation, scale = TRUE)[, 3]
```

```{r}
head(sort(varimp, decreasing = TRUE), 25)
```


